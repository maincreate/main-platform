# Optional machine-to-machine gateway secrets (not user accounts).
# Generate different values only when enabling the MCP gateway:
TT_SERVICE_TOKEN=
TT_MCP_TOKEN=
# Optional: hostname mapped to gateway:3001; keep disabled until OAuth is ready.
TT_TUNNEL_TOKEN=
PORTAL_PORT=13000
TT_MCP_PORT=13001
# The first administrator is created in /setup with a setup code from runtime logs.
# No TT_ADMIN_TOKEN or user password environment variable is required.
