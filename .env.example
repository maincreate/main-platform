# Copy to .env on the Docker host; never commit real values.
# Generate four DIFFERENT secrets with: openssl rand -hex 32
TT_ADMIN_TOKEN=
TT_MASTER_KEY=
TT_SERVICE_TOKEN=
TT_MCP_TOKEN=
# Optional: hostname mapped to gateway:3001; keep disabled until OAuth is ready.
TT_TUNNEL_TOKEN=
PORTAL_PORT=13000
TT_MCP_PORT=13001
