# Optional machine-to-machine gateway secrets (not user accounts).
# Generate different values only when enabling the MCP gateway:
MAIN_SERVICE_TOKEN=
MAIN_MCP_TOKEN=
# Optional, after account creation: public OAuth application client ID for GitHub device authorization.
# The GitHub app must have device authorization enabled; this is not a user secret.
MAIN_GITHUB_CLIENT_ID=
# Optional: hostname mapped to gateway:3001; keep disabled until OAuth is ready.
MAIN_TUNNEL_TOKEN=
PORTAL_PORT=13000
MAIN_MCP_PORT=13001
# Administrator self-registers in /setup; there is NO setup code.
# Explicit operator opt-in for APPROVED runner jobs only; disabled by default.
MAIN_ENABLE_FABRIC_EXECUTION=0
# Runner-specific (set on a trusted runner, not the portal):
# MAIN_RUNNER_ENABLE_BUILDS=0
# MAIN_RUNNER_PROJECTS_JSON={"MainCreate/WaymarkerOS":"/home/builder/WaymarkerOS"}
# MAIN_RUNNER_IDF_CMD=idf.py
# No MAIN_ADMIN_TOKEN or user password environment variable is required.
