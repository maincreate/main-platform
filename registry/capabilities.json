      }
    ]
  },
  {
    "id": "firmware.esp_idf.build",
    "version": "1.0.0",
    "kind": "action",
    "risk": "build",
    "state": "available",
    "description": "Compile an operator-allowlisted local ESP-IDF checkout without downloading, flashing or changing its revision. Runner opt-in required. The exact 40-character local checkout revision is mandatory.",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        }
      },
      "required": [
        "repository",
        "revision"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "capability": "firmware.esp_idf.build"
      }
    ]
  },
  {
    "id": "workflow.esp_idf.preflight_build",
    "version": "1.0.0",
    "kind": "workflow",
    "risk": "build",
    "state": "available",
    "description": "Run a host snapshot followed by an approved ESP-IDF build on the same allowlisted machine. The exact 40-character local checkout revision is mandatory.",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        }
      },
      "required": [
        "repository",
        "revision"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "capability": "host.snapshot"
      },
      {
        "capability": "firmware.esp_idf.build"
      }
    ]
  },
