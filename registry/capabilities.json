  {
    "id": "firmware.esp_idf.build",
    "version": "1.1.0",
    "kind": "action",
    "risk": "build",
    "state": "available",
    "description": "Build an allowlisted clean ESP-IDF checkout with the exact selected marketplace version and target chip; upload a checksum-manifested firmware bundle. No device write.",
    "platforms": "linux",
    "architectures": [
      "arm64",
      "x64"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "toolkit_version": {
          "type": "string",
          "pattern": "^(5\\\\.5\\\\.6|6\\\\.1\\\\.1)$"
        },
        "target_chip": {
          "type": "string",
          "pattern": "^(esp32|esp32s2|esp32s3|esp32c3|esp32c6|esp32h2|esp32p4)$"
        }
      },
      "required": [
        "repository",
        "revision",
        "toolkit_version",
        "target_chip"
      ],
      "additionalProperties": false
    },
    "steps": [
      {
        "capability": "firmware.esp_idf.build"
      }
    ]
  },
