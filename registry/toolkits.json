            "source": "https://github.com/arduino/arduino-cli/releases/tag/v1.5.1"
          }
        ],
        "compatibility": {
          "install": [
            {
              "os": "linux",
              "architecture": "arm64",
              "status": "supported"
            },
            {
              "os": "linux",
              "architecture": "x64",
              "status": "supported"
            }
          ],
          "build": [
            {
              "os": "linux",
              "architecture": "arm64",
              "status": "supported"
            },
            {
              "os": "linux",
              "architecture": "x64",
              "status": "supported"
            }
          ],
