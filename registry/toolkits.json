        "deviceSupport": {
          "families": [
            "espressif-esp32"
          ],
          "chips": [
            "ESP32",
            "ESP32-S2",
            "ESP32-S3",
            "ESP32-C3",
            "ESP32-C6",
            "ESP32-H2",
            "ESP32-P4"
          ],
          "transports": [
            "usb-serial",
            "usb-jtag"
          ],
          "probe": "esptool chip_id/read_mac",
          "usbDescriptorIsChipProof": false,
          "activeChipProbeRequired": true
        },
        "operations": {
          "build": {
            "capabilityId": "firmware.build",
            "artifactType": "esp32-firmware-bundle",
            "outputs": [
              "bootloader",
              "partition-table",
              "application",
              "declared-data-partitions",
              "merged-full-firmware-image"
            ],
            "targetFamily": "espressif-esp32",
            "runnerLabels": [
              "toolkit-esp-idf-5-5-6",
              "capability-firmware-build",
              "target-esp32"
            ]
          },
          "deploy": {
            "capabilityId": "firmware.flash",
            "operationType": "flash-firmware-image",
            "artifactType": "esp32-firmware-bundle",
            "targetObjectType": "esp32-device",
            "requiresActiveChipProbe": true,
            "requiresMatchingChipAndFlashLayout": true,
            "requiresExplicitApproval": true,
            "runnerLabels": [
              "toolkit-esp-idf-5-5-6",
              "capability-firmware-deploy",
              "target-esp32"
            ]
          },
          "backup": {
            "capabilityId": "firmware.backup",
            "objectType": "esp32-device-firmware-image",
            "methods": [
              "flash-readback",
              "partition-table-read"
            ],
            "requiresActiveChipProbe": true,
            "requiresExplicitApproval": true,
            "limitations": [
              "Readback can be blocked or unusable with flash encryption, secure boot, read protection, or chip-specific security configuration.",
              "Backup manifest must record chip model, flash size, partition table, security observations, source device identity, SHA-256 and provenance.",
              "This is a firmware-image backup, not a generic backup of all device state or external peripherals."
            ],
            "runnerLabels": [
              "toolkit-esp-idf-5-5-6",
              "capability-firmware-backup",
              "target-esp32"
            ]
          },
          "restore": {
            "capabilityId": "firmware.restore",
            "objectType": "esp32-device-firmware-image",
            "operationType": "restore-firmware-image",
            "requiresExactChipMatch": true,
            "requiresFlashSizeMatch": true,
            "requiresPartitionLayoutMatch": true,
            "requiresActiveChipProbe": true,
            "requiresExplicitApproval": true,
            "limitations": [
              "Reject incompatible chip family, flash size, partition layout or security state."
            ],
            "runnerLabels": [
              "toolkit-esp-idf-5-5-6",
              "capability-firmware-restore",
              "target-esp32"
            ]
          }
        },
        "lifecycle": {
          "install": {
            "state": "planned",
            "recipeId": "espressif.esp-idf.install",
            "versionScoped": true,
            "requiresExplicitApproval": true
          },
          "build": {
            "state": "partial",
            "capabilityId": "firmware.build",
            "requiresInstalledVersion": true,
            "requiresPinnedProjectRevision": true,
            "versionGuardRequired": true
          },
          "deploy": {
            "state": "planned",
            "capabilityId": "firmware.flash",
            "requiresActiveChipProbe": true,
            "requiresExplicitApproval": true,
            "requiresMatchingChipAndImage": true
          },
          "backup": {
            "state": "planned",
            "capabilityId": "firmware.backup",
            "requiresActiveChipProbe": true,
            "requiresExplicitApproval": true
          },
          "restore": {
            "state": "planned",
            "capabilityId": "firmware.restore",
            "requiresExactDeviceMatch": true,
            "requiresActiveChipProbe": true,
            "requiresExplicitApproval": true
          },
          "cleanup": {
            "state": "planned",
            "recipeId": "espressif.esp-idf.remove-version",
            "instructions": "Remove only the selected EIM-managed ESP-IDF version and its version-owned toolchain/cache after active jobs release it. Show a dry-run inventory and require approval.",
            "preserves": [
              "project checkouts",
              "sdkconfig and sdkconfig.defaults",
              "build outputs and firmware artifacts",
              "logs",
              "firmware backups",
              "other installed ESP-IDF versions"
            ]
          }
        },
        "constraints": [
          "A build runner and a firmware deployment runner may be different machines; pass a signed artifact manifest between them.",
          "Register GitHub labels only after the exact version and capability are verified on that runner.",
          "The current ESP-IDF build adapter is partial until it enforces the marketplace-selected installed version."
        ],
