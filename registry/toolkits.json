          "deploy": {
            "state": "unsupported"
          },
          "backup": {
            "state": "unsupported"
          },
          "restore": {
            "state": "unsupported"
          },
          "cleanup": {
            "state": "planned",
            "recipeId": "arduino-cli.remove-version",
            "instructions": "Remove only the selected per-user Arduino CLI version after active jobs release it; preserve sketch projects, build artifacts and configuration."
          }
        },
