            "requiresPartitionLayoutMatch": true,
            "requiresActiveChipProbe": true,
            "requiresExplicitApproval": true,
            "limitations": [
              "Reject incompatible chip family, flash size, partition layout or security state."
            ],
            "runnerLabels": [
              "toolkit-esp-idf-5-5-6",
              "capability-firmware-restore",
              "target-esp32"
