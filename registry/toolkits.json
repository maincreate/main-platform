  {
    "id": "esp-idf",
    "schemaVersion": 2,
    "displayName": "Espressif IoT Development Framework",
    "category": "firmware",
    "state": "pilot",
    "installation": "maincreate-managed",
    "description": "Versioned Espressif firmware toolchain. Builds complete ESP32 firmware bundles; deployment flashes firmware to a matching ESP32 device. Firmware backup and restore operate on firmware-image objects, not generic device backups.",
    "publisher": {
      "name": "Espressif Systems",
      "source": "https://github.com/espressif/esp-idf"
    },
    "trust": {
      "tier": "maincreate-endorsed-pending-validation",
      "basis": "official-upstream-release",
      "versionValidationRequired": true
    },
    "capabilities": [
      "firmware.build",
      "firmware.flash",
      "firmware.backup",
      "firmware.restore"
    ],
    "versions": [
      {
        "version": "5.5.6",
        "channel": "stable",
        "status": "pilot",
        "releaseUrl": "https://github.com/espressif/esp-idf/releases/tag/v5.5.6",
        "installer": {
          "name": "Espressif Installation Manager CLI",
          "version": "0.21.1",
          "source": "https://github.com/espressif/idf-im-ui/releases/tag/v0.21.1"
        },
        "components": {
          "framework": "ESP-IDF",
          "frameworkVersion": "5.5.6",
          "installer": "EIM CLI 0.21.1",
          "buildTools": [
            "CMake",
            "Ninja",
            "Python"
          ],
          "toolchain": "version-matched Espressif cross-compilers",
          "installCommand": "eim install -i v{version} -n true --cleanup true",
          "installRoot": "~/.local/share/maincreate/toolkits/esp-idf"
        },
        "compatibility": {
