    "category": "firmware",
    "state": "pilot",
    "installation": "maincreate-managed",
    "description": "Version-pinned Arduino CLI installation for Linux ARM64 and x64 builders. This toolkit installs and compiles Arduino sketches; device upload is a separate board- and transport-specific operation.",
    "publisher": {
      "name": "Arduino",
      "source": "https://github.com/arduino/arduino-cli"
    },
    "trust": {
      "tier": "maincreate-endorsed",
      "basis": "official-upstream-release",
      "versionValidationRequired": true
    },
    "capabilities": [
      "sdk.arduino_cli.install"
    ],
    "versions": [
      {
